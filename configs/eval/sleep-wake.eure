// Focused homeostatic runtime for sleep onset and salient wake-up scenarios.
// The speak and memory-compaction roles are present as suppression/drive
// targets; unrelated prediction, surprise, policy, and reward roles are absent.
activation-table = [1.0, 0.85, 0.7, 0.5, 0.3, 0.0]

@ modules[] {
  id: sensory
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 20.0
  bpm-max = 30.0
  initial-activation = 1.0
}

@ modules[] {
  id: allocation
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 10.0
  bpm-max = 10.0
  initial-activation = 1.0
}

@ modules[] {
  id: interoception
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 1.0
  bpm-max = 3.0
  initial-activation = 1.0
}

@ modules[] {
  id: homeostasis
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 6.0
  bpm-max = 20.0
  initial-activation = 1.0
}

@ modules[] {
  id: memory-compaction
  replica-min = 0
  replica-max = 1
  replica-capacity = 2
  bpm-min = 0.5
  bpm-max = 1.0
  initial-activation = 0.0
  groups = ["homeostatic-drive"]
  depends-on = ["homeostasis"]
}

@ modules[] {
  id: speak
  replica-min = 0
  replica-max = 1
  replica-capacity = 2
  bpm-min = 6.0
  bpm-max = 15.0
  initial-activation = 0.0
  groups = ["sleep-suppressed"]
}
