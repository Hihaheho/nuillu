// Smallest conversational cognition loop: perceive, admit cognition, allocate,
// choose an action, and speak. It intentionally has no memory, interpretation,
// self-model, attention-schema, or background/homeostatic modules.
activation-table = [1.0, 0.85, 0.7, 0.5, 0.3, 0.0]

@ modules[] {
  id: sensory
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 20.0
  bpm-max = 30.0
  initial-activation = 1.0
}

@ modules[] {
  id: cognition-gate
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 20.0
  bpm-max = 30.0
  initial-activation = 1.0
}

@ modules[] {
  id: allocation
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 10.0
  bpm-max = 10.0
  initial-activation = 1.0
}

@ modules[] {
  id: action
  replica-min = 1
  replica-max = 1
  replica-capacity = 2
  bpm-min = 3.0
  bpm-max = 9.0
  initial-activation = 0.0
  groups = ["voluntary", "sleep-suppressed"]
  depends-on = ["cognition-gate"]
}

@ modules[] {
  id: speak
  replica-min = 0
  replica-max = 1
  replica-capacity = 2
  bpm-min = 6.0
  bpm-max = 15.0
  initial-activation = 0.0
  groups = ["sleep-suppressed", "action-target"]
  depends-on = ["cognition-gate"]
}
